@import 'tailwindcss';

/* Dark is a scope, not a page mode.
   Wrap a hero or footer in class="dark" and everything inside it flips. */
@custom-variant dark (&:is(.dark *));

/* ============================================================
   1. Palette
   Light is the default. Dark overrides the same names.
   Every token below exists in both blocks.
   ============================================================ */

:root {
  --background: #ffffff;
  --foreground: #111c13;

  --surface: #f5f7f4;

  --card: #ffffff;
  --card-foreground: #111c13;

  --popover: #ffffff;
  --popover-foreground: #111c13;

  --primary: #3a7a45;
  --primary-foreground: #ffffff;

  --secondary: #f5f7f4;
  --secondary-foreground: #111c13;

  --muted: #f5f7f4;
  --muted-foreground: #4a6b4c;

  --subtle: #5f7360;

  --accent: #eef4ee;
  --accent-foreground: #111c13;

  --highlight: #b06d14;
  --highlight-foreground: #ffffff;

  --destructive: #b3261e;
  --destructive-foreground: #ffffff;

  --border: #dde8dd;
  --input: #dde8dd;
  --ring: #3a7a45;

  --radius: 0.75rem;
}

.dark {
  --background: #111c13;
  --foreground: #dde8de;

  --surface: #141e15;

  --card: #172019;
  --card-foreground: #dde8de;

  --popover: #172019;
  --popover-foreground: #dde8de;

  --primary: #7ab87a;
  --primary-foreground: #0f1f10;

  --secondary: #1c2a1e;
  --secondary-foreground: #9dcc8f;

  --muted: #223226;
  --muted-foreground: #8ba88d;

  --subtle: #7a8c7b;

  --accent: #1c2a1e;
  --accent-foreground: #dde8de;

  --highlight: #d4892a;
  --highlight-foreground: #6b3d00;

  --destructive: #e5484d;
  --destructive-foreground: #ffffff;

  --border: #1c2e1e;
  --input: #223226;
  --ring: #7ab87a;
}

/* ============================================================
   2. Expose the palette to Tailwind.
   "inline" keeps the utilities pointing at var(), which is what
   lets .dark flip them at runtime.
   ============================================================ */

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-surface: var(--surface);

  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);

  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);

  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);

  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);

  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);

  --color-subtle: var(--subtle);

  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);

  --color-highlight: var(--highlight);
  --color-highlight-foreground: var(--highlight-foreground);

  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);

  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --font-sans: 'Inter', ui-sans-serif, system-ui, sans-serif;
  --font-serif: 'Playfair Display', ui-serif, Georgia, serif;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

/* ============================================================
   3. Base
   ============================================================ */

@layer base {
  * {
    border-color: var(--border);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--background);
    color: var(--foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  button {
    cursor: pointer;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
}

/* ============================================================
   4. Components
   The .btn-* classes are temporary. They go once the shadcn
   Button lands and the pages are switched over.
   ============================================================ */

@layer components {
  .glass {
    background-color: color-mix(in srgb, var(--surface) 50%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  }

  .glass-strong {
    background-color: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  }

  .glow-text {
    text-shadow: 0 0 30px color-mix(in srgb, var(--primary) 40%, transparent);
  }

  .glow-border {
    box-shadow:
      0 0 20px color-mix(in srgb, var(--primary) 15%, transparent),
      inset 0 0 20px color-mix(in srgb, var(--primary) 5%, transparent);
  }

  .animated-border:hover {
    background-color: color-mix(in srgb, var(--primary) 8%, transparent);
    backdrop-filter: blur(16px);
    box-shadow: 0 0 20px color-mix(in srgb, var(--primary) 15%, transparent);
  }

  .btn-primary {
    background-color: var(--primary);
    color: var(--primary-foreground);
    border-radius: 999px;
    padding: 11px 28px;
    font-size: 13px;
    font-weight: 500;
    border: none;
  }

  .btn-secondary {
    background-color: var(--secondary);
    color: var(--secondary-foreground);
    border-radius: 999px;
    padding: 11px 28px;
    font-size: 13px;
    font-weight: 500;
    border: none;
  }

  .btn-outline {
    background-color: transparent;
    color: var(--foreground);
    border-radius: 999px;
    padding: 10px 28px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid var(--border);
  }
}

/* ============================================================
   5. Animation
   ============================================================ */

@layer utilities {
  @keyframes animated-border {
    0% {
      stroke-dashoffset: 400;
    }
    100% {
      stroke-dashoffset: -550;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  .group:hover .animated-border-path {
    animation: animated-border 1.5s linear infinite;
  }

  .timeline-glow {
    box-shadow:
      0 0 40px color-mix(in srgb, var(--primary) 25%, transparent),
      0 0 80px color-mix(in srgb, var(--primary) 15%, transparent);
  }
}

/* ============================================================
   6. Respect the user's motion setting
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
